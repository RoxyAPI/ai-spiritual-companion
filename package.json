{
  "name": "ai-spiritual-companion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write .",
    "check": "biome check . --fix",
    "check:ci": "biome ci .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/spec-drift.test.ts",
    "test:drift": "vitest run tests/spec-drift.test.ts",
    "verify": "npm run check:ci && npm run lint && npm run typecheck && npm test && npm run build",
    "db:reset": "npx supabase db reset",
    "db:types": "npx supabase gen types typescript --local",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/mcp": "^2.0.49",
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/react": "^4.0.102",
    "@roxyapi/sdk": "^1.2.80",
    "@roxyapi/ui-react": "^0.42.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "ai": "^7.0.87",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "lefthook": "^2.1.10",
    "schema-dts": "^2.0.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
