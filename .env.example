# Copy this file to .env.local and fill in the values below. .env.local is gitignored, so nothing
# you put in it is ever committed. Everything marked REQUIRED is needed for a local run.

# ---------------------------------------------------------------------------------------------
# RoxyAPI: the calculations. Charts, transits, tarot, city coordinates.
# ---------------------------------------------------------------------------------------------

# REQUIRED. Your RoxyAPI key. It is read on the server only, and it is never prefixed
# NEXT_PUBLIC_, so it cannot reach the browser.
# Get one here: https://roxyapi.com/pricing
ROXYAPI_KEY=your_roxyapi_key_here

# Optional. Which RoxyAPI domains the companion can reach during a conversation, as a comma
# separated list of slugs. Leave it unset and the lean default in src/lib/mcp.ts is used.
#
# Every slug available today:
#   astrology, vedic-astrology, forecast, human-design, chinese-astrology, feng-shui,
#   numerology, tarot, biorhythm, iching, crystals, dreams, angel-numbers, location
#
# Two things worth knowing before you add more. Every domain you enable puts its tools in front
# of the model on every turn, and models choose better from a short list than a long one, so
# enable the domains your companion actually needs rather than all of them. A stronger model
# handles a longer list comfortably, so this is a dial and not a rule. And new RoxyAPI domains
# become available here automatically: add the slug, no code change and no upgrade.
# ROXYAPI_MCP_PRODUCTS=astrology,forecast,tarot,location

# ---------------------------------------------------------------------------------------------
# Supabase: identity, the database, and the memory.
# ---------------------------------------------------------------------------------------------

# REQUIRED, both of them. Run `npx supabase start` and it prints an API URL and a publishable
# key (older versions call it the anon key). Paste them here.
#
# Both values are public by design and safe to ship to the browser, because row level security is
# enabled on every table and every policy is keyed to the signed in user.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key_here

# ---------------------------------------------------------------------------------------------
# The language model: the conversation itself.
# ---------------------------------------------------------------------------------------------

# REQUIRED. Which provider answers. One of: google (default), anthropic, openai.
# Whichever you pick, set that provider key below and leave the others commented out.
LLM_PROVIDER=google

# REQUIRED when LLM_PROVIDER=google, which is the default. Google has a free tier, and the same
# key also covers the embeddings that make the companion recall by meaning, so a local run needs
# two keys in total rather than three. This exact variable name is the one the AI SDK Google
# provider reads, so do not rename it.
# Get one here: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# Optional. Only needed if you set LLM_PROVIDER=anthropic. Chat only: there is no embedding
# endpoint, so recall falls back to most recent first, which still works.
# Get one here: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional. Only needed if you set LLM_PROVIDER=openai. Covers the conversation and the
# embeddings, same as Google.
# Get one here: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
